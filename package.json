{
  "name": "anchora",
  "private": true,
  "version": "0.1.0",
  "description": "Anchora \u2014 an evidence core for audit trails in sealed environments.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:seal": "npm run dev -w apps/seal",
    "dev:witness": "npm run dev -w apps/witness",
    "test": "vitest run",
    "test:pbt": "PBT_RUNS=1000 vitest run",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run typecheck && npm run security:check && npx vitest run",
    "verify:bundle": "vite-node tools/verify/index.ts --",
    "generate:stream": "vite-node scripts/generate-stream.ts",
    "typecheck": "tsc -p packages/core && tsc -p apps/seal && tsc -p apps/witness && tsc -p tools",
    "build": "npm run build -w apps/seal && npm run build -w apps/witness"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
